---
import MainLayout from '../components/layout/MainLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import ProgressiveImage from '../components/common/ProgressiveImage.astro';
import { r2Asset } from '../utils/assets';

const title = 'Nuestras instalaciones — Clínica Dental en Pamplona y Tafalla | Sada Borrás';
const description = 'Conoce las instalaciones de la Clínica Dental Sada Borrás en Pamplona y Tafalla. Gabinetes equipados, diagnóstico digital y espacios diseñados para tu confort y seguridad.';
const keywords = 'instalaciones clínica dental Pamplona, clínica dental Tafalla, tecnología dental, gabinetes dentales, escáner intraoral, diagnóstico digital, clínica dental Navarra';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const heroImage = r2Asset('img/pamplona/ESPACIOS/FACHADA/_MG_9825', 'high');

const faqItems = [
	{
		question: '¿Puedo visitar la clínica antes de empezar un tratamiento?',
		answer: 'Por supuesto. En tu primera visita te acompañamos por las instalaciones y te explicamos cómo trabajamos. No hay ningún compromiso.',
	},
	{
		question: '¿Las dos clínicas ofrecen los mismos servicios?',
		answer: 'Ambas clínicas comparten equipo profesional y estándares de calidad. La clínica de Pamplona dispone de más gabinetes y equipamiento específico para cirugía avanzada e implantología. Tafalla cubre las especialidades más demandadas: conservadora, ortodoncia, odontopediatría y tratamientos generales.',
	},
	{
		question: '¿Qué medidas de higiene y seguridad aplican?',
		answer: 'Seguimos protocolos de esterilización con trazabilidad por ciclo, desinfección de superficies entre pacientes, circuitos diferenciados de material limpio y usado, y ventilación adecuada. Son prácticas alineadas con las recomendaciones de los colegios profesionales.',
	},
	{
		question: '¿Qué hago si tengo miedo al dentista?',
		answer: 'Es más habitual de lo que parece. En Pamplona disponemos de sedación consciente con óxido nitroso. En ambas clínicas, el equipo está acostumbrado a trabajar con pacientes que necesitan más tiempo y más explicaciones. Solo empezamos cuando tú estés preparado.',
	},
];
---

<MainLayout title={title} description={description} keywords={keywords}>
	<Header />
	<main id="main-content">
		<article class="installations-page">

			<nav class="breadcrumbs" aria-label="Migas de pan">
				<div class="container">
					<ol>
						<li><a href={baseUrl}>Inicio</a></li>
						<li aria-current="page">Instalaciones</li>
					</ol>
				</div>
			</nav>

			<section class="page-hero" style={`--hero-bg: url(${heroImage})`}>
				<div class="container">
					<h1>Nuestras instalaciones</h1>
					<p class="hero-subtitle">Dos clínicas en Navarra diseñadas para que te sientas bien atendido, con la tecnología que cada tratamiento necesita</p>
				</div>
			</section>

			<section class="section">
				<div class="container">
					<blockquote class="intro-quote">
						<p>El entorno en el que te atendemos forma parte de tu experiencia como paciente. Nuestras instalaciones clínicas en Pamplona y Tafalla están pensadas para generar confianza desde el primer momento: gabinetes amplios, equipamiento digital actualizado y un equipo profesional que cuida los detalles que no siempre se ven.</p>
					</blockquote>
				</div>
			</section>

			<!-- ========== PAMPLONA ========== -->
			<section class="section section-alt" id="pamplona">
				<div class="container">

					<div class="section-split">
						<div class="section-split__heading">
							<h2>Clínica dental en Pamplona</h2>
							<p class="clinic-address">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
								Avenida Pío XII, 8 · 31008 Pamplona
							</p>
						</div>
						<div class="section-split__content">
							<p>Nuestra clínica en la Avenida Pío XII ocupa un local amplio y luminoso a pie de calle. Gabinetes equipados para cirugía, implantología, conservadora y estética dental. Tecnología digital actualizada y protocolos de esterilización rigurosos.</p>
						</div>
					</div>

					<div class="feature-image">
						<ProgressiveImage src="img/pamplona/ESPACIOS/FACHADA/_MG_9811" alt="Fachada de la Clínica Dental Sada Borrás en la Avenida Pío XII, Pamplona" loading="lazy" width={1200} height={600} />
					</div>

					<div class="feature-cards">
						<div class="feature-card">
							<div class="feature-card__icon">
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
							</div>
							<h3>Gabinetes equipados</h3>
							<p>Varios gabinetes preparados para cirugía oral, implantología, conservadora y estética. Cada uno con el instrumental y la iluminación que el tratamiento requiere.</p>
						</div>
						<div class="feature-card">
							<div class="feature-card__icon">
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
							</div>
							<h3>Tecnología digital</h3>
							<p>Escáner intraoral, radiología digital de baja dosis, CBCT para planificación 3D y sedación consciente con óxido nitroso.</p>
						</div>
						<div class="feature-card">
							<div class="feature-card__icon">
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
							</div>
							<h3>Esterilización y seguridad</h3>
							<p>Autoclave con trazabilidad por ciclo, cuba de ultrasonidos y selladora. Protocolos alineados con las guías de los colegios profesionales.</p>
						</div>
					</div>

					<div class="content-row">
						<div class="content-row__text">
							<h3>Tu recorrido por la clínica</h3>
							<p>Desde que entras, todo es intuitivo: recepción, zona de espera y acceso directo a los gabinetes. El despacho de consulta permite explicarte el diagnóstico y el plan de tratamiento con calma —ya desde tu primera visita—, con imágenes y registros digitales para que entiendas cada paso.</p>
						</div>
						<div class="content-row__image">
							<ProgressiveImage src="img/pamplona/ESPACIOS/RECEPCION Y PASILLO ACCESO GABINETES/_MG_9776" alt="Recepción y zona de paso de la clínica dental en Pamplona" loading="lazy" width={500} height={400} />
						</div>
					</div>

					<div class="photo-mosaic">
						<div class="photo-mosaic__wide">
							<ProgressiveImage src="img/pamplona/ESPACIOS/GABINETE B/_MG_9799" alt="Gabinete dental equipado en la clínica de Pamplona" loading="lazy" width={700} height={450} />
						</div>
						<div class="photo-mosaic__tall">
							<ProgressiveImage src="img/pamplona/ESPACIOS/GABINETE A/_MG_9795" alt="Gabinete con sillón dental preparado para tratamiento" loading="lazy" width={400} height={500} />
						</div>
						<div class="photo-mosaic__square">
							<ProgressiveImage src="img/pamplona/ESPACIOS/DESPACHO/_MG_9805" alt="Despacho de consulta para diagnóstico y planificación" loading="lazy" width={400} height={400} />
						</div>
						<div class="photo-mosaic__square">
							<ProgressiveImage src="img/pamplona/ESPACIOS/PASILLO INTERIOR/_MG_9889" alt="Pasillo interior con acceso a gabinetes en Pamplona" loading="lazy" width={400} height={400} />
						</div>
						<div class="photo-mosaic__wide-bottom">
							<ProgressiveImage src="img/pamplona/ESPACIOS/RECEPCION Y PASILLO ACCESO GABINETES/_MG_9787" alt="Zona de acceso a gabinetes desde la recepción en Pamplona" loading="lazy" width={700} height={350} />
						</div>
					</div>

					<div class="content-row reverse">
						<div class="content-row__text">
							<h3>Diagnóstico digital de precisión</h3>
							<p>El <strong>escáner intraoral</strong> permite tomar registros rápidos y cómodos, sin pastas de impresión. Cuando el caso lo requiere, el <strong>CBCT</strong> nos da una imagen tridimensional para planificar implantes y cirugías con la máxima precisión.</p>
						</div>
						<div class="content-row__image">
							<ProgressiveImage src="img/pamplona/ESPACIOS/ESCANER/_MG_9802" alt="Escáner intraoral para registros digitales sin molestias" loading="lazy" width={500} height={400} />
						</div>
					</div>

					<div class="detail-strip">
						<div class="detail-strip__item">
							<ProgressiveImage src="img/pamplona/DETALLES/_MG_9908" alt="Autoclave y selladora del área de esterilización" loading="lazy" width={300} height={220} />
							<p class="detail-strip__caption">Esterilización</p>
						</div>
						<div class="detail-strip__item">
							<ProgressiveImage src="img/pamplona/DETALLES/_MG_9809" alt="Equipo de ozonoterapia en la clínica de Pamplona" loading="lazy" width={300} height={220} />
							<p class="detail-strip__caption">Ozono</p>
						</div>
						<div class="detail-strip__item">
							<ProgressiveImage src="img/pamplona/DETALLES/_MG_9820" alt="Sistema de óxido nitroso para sedación consciente" loading="lazy" width={300} height={220} />
							<p class="detail-strip__caption">Sedación consciente</p>
						</div>
						<div class="detail-strip__item">
							<ProgressiveImage src="img/pamplona/DETALLES/_MG_9841" alt="Detalle del logo de Sada Borrás en la puerta de la clínica" loading="lazy" width={300} height={220} />
							<p class="detail-strip__caption">Sada Borrás</p>
						</div>
					</div>

				</div>
			</section>

			<!-- ========== TAFALLA ========== -->
			<section class="section section--dark" id="tafalla">
				<div class="container">

					<div class="section-split">
						<div class="section-split__heading">
							<h2>Clínica dental en Tafalla</h2>
							<p class="clinic-address">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
								Diputación Foral, 2 · 31300 Tafalla
							</p>
						</div>
						<div class="section-split__content">
							<p>La clínica de Tafalla nació para que los pacientes de la Zona Media de Navarra accedan a la misma calidad de atención sin desplazarse. Recepción acogedora, tres gabinetes completos y equipamiento digital para diagnóstico y seguimiento.</p>
						</div>
					</div>

					<div class="feature-image">
						<ProgressiveImage src="img/tafalla/ESTANCIAS/RECEPCION/_MG_0629" alt="Recepción de la Clínica Dental Sada Borrás en Tafalla" loading="lazy" width={1200} height={600} />
					</div>

					<div class="content-row">
						<div class="content-row__text">
							<h3>Un espacio pensado para tu comodidad</h3>
							<p>La sala de espera es tranquila y luminosa. Las citas se organizan con holgura para que los tiempos se respeten y la visita sea predecible. El equipo conoce a cada paciente y eso marca la diferencia.</p>
						</div>
						<div class="content-row__image">
							<ProgressiveImage src="img/tafalla/ESTANCIAS/SALA DE ESPERA/_MG_0535" alt="Sala de espera de la clínica dental en Tafalla" loading="lazy" width={500} height={400} />
						</div>
					</div>

					<div class="photo-mosaic">
						<div class="photo-mosaic__wide">
							<ProgressiveImage src="img/tafalla/ESTANCIAS/GABINETE A/_MG_0542" alt="Gabinete dental equipado en la clínica de Tafalla" loading="lazy" width={700} height={450} />
						</div>
						<div class="photo-mosaic__tall">
							<ProgressiveImage src="img/tafalla/ESTANCIAS/GABINETE B/_MG_0573" alt="Gabinete con iluminación quirúrgica en Tafalla" loading="lazy" width={400} height={500} />
						</div>
						<div class="photo-mosaic__square">
							<ProgressiveImage src="img/tafalla/ESTANCIAS/RECEPCION/_MG_0627" alt="Mostrador de recepción en la clínica de Tafalla" loading="lazy" width={400} height={400} />
						</div>
						<div class="photo-mosaic__square">
							<ProgressiveImage src="img/tafalla/ESTANCIAS/SALA DE ESPERA/_MG_0537" alt="Zona de espera con luz natural en Tafalla" loading="lazy" width={400} height={400} />
						</div>
						<div class="photo-mosaic__wide-bottom">
							<ProgressiveImage src="img/tafalla/ESTANCIAS/ESCANER/_MG_0583" alt="Sala del escáner extraoral en la clínica de Tafalla" loading="lazy" width={700} height={350} />
						</div>
					</div>

					<div class="feature-cards">
						<div class="feature-card">
							<div class="feature-card__icon">
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
							</div>
							<h3>Tres gabinetes completos</h3>
							<p>Preparados para conservadora, ortodoncia, odontopediatría y cirugía menor. Cada gabinete con su propio equipamiento e iluminación quirúrgica.</p>
						</div>
						<div class="feature-card">
							<div class="feature-card__icon">
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
							</div>
							<h3>Diagnóstico digital</h3>
							<p>Escáner extraoral y equipamiento de imagen para que cada tratamiento parta de un estudio preciso desde la primera visita.</p>
						</div>
						<div class="feature-card">
							<div class="feature-card__icon">
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg>
							</div>
							<h3>Trato cercano</h3>
							<p>Citas organizadas con holgura, tiempos respetados y un equipo que conoce a cada paciente. La clínica donde el Ratoncito Pérez tiene su propio rincón.</p>
						</div>
					</div>

					<div class="content-row reverse">
						<div class="content-row__text">
							<h3>Ortodoncia y tratamiento especializado</h3>
							<p>La sala de ortodoncia está preparada para trabajar con alineadores y brackets. El gabinete de cirugía incorpora iluminación quirúrgica de alta calidad para intervenciones que requieren máxima visibilidad.</p>
						</div>
						<div class="content-row__image">
							<ProgressiveImage src="img/tafalla/ESTANCIAS/GABINETE D/_MG_0589" alt="Sala de ortodoncia de la clínica dental en Tafalla" loading="lazy" width={500} height={400} />
						</div>
					</div>

					<div class="detail-strip">
						<div class="detail-strip__item">
							<ProgressiveImage src="img/tafalla/ESTANCIAS/GABINETE B/_MG_0575" alt="Escáner extraoral para diagnóstico por imagen en Tafalla" loading="lazy" width={300} height={220} />
							<p class="detail-strip__caption">Escáner extraoral</p>
						</div>
						<div class="detail-strip__item">
							<ProgressiveImage src="img/tafalla/DETALLES/_MG_0225" alt="Lámpara quirúrgica de alta intensidad" loading="lazy" width={300} height={220} />
							<p class="detail-strip__caption">Iluminación quirúrgica</p>
						</div>
						<div class="detail-strip__item">
							<ProgressiveImage src="img/tafalla/ESTANCIAS/GABINETE B/_MG_0576" alt="Gabinete equipado con instrumental dental en Tafalla" loading="lazy" width={300} height={220} />
							<p class="detail-strip__caption">Instrumental</p>
						</div>
						<div class="detail-strip__item">
							<ProgressiveImage src="img/tafalla/DETALLES/_MG_0032" alt="Rincón del Ratoncito Pérez en la clínica de Tafalla" loading="lazy" width={300} height={220} />
							<p class="detail-strip__caption">Ratoncito Pérez</p>
						</div>
					</div>

				</div>
			</section>

			<!-- FAQ -->
			<section class="section faq-section" id="preguntas-frecuentes">
				<div class="container">
					<h2>Preguntas frecuentes sobre nuestras clínicas</h2>
					<div class="faq-accordion">
						{faqItems.map((item) => (
							<div class="faq-item">
								<button class="faq-question" aria-expanded="false">
									<span>{item.question}</span>
									<svg class="faq-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="6 9 12 15 18 9"/>
									</svg>
								</button>
								<div class="faq-answer">
									<p>{item.answer}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="section cta-section">
				<div class="container">
					<div class="cta-box">
						<h2>Tu comodidad, nuestra prioridad</h2>
						<p>Sabemos que ir al dentista no siempre resulta fácil. Por eso cuidamos cada detalle de tu experiencia como paciente: te explicamos lo que vamos a hacer antes de empezar, ajustamos tiempos para evitar esperas innecesarias y nos aseguramos de que tengas toda la información para decidir con confianza.</p>
						<p>Si todavía no nos conoces, la mejor forma de empezar es con una primera visita.</p>
						<div class="cta-buttons">
							<a href={`${baseUrl}#contacto`} class="btn btn-primary">Pedir cita</a>
							<a href="tel:+34948172617" class="btn btn-secondary">Llamar ahora</a>
						</div>
					</div>
				</div>
			</section>

		</article>
	</main>
	<Footer />

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://sadaborras.com/" },
			{ "@type": "ListItem", "position": 2, "name": "Instalaciones", "item": "https://sadaborras.com/instalaciones" }
		]
	})} />

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": faqItems.map(item => ({
			"@type": "Question",
			"name": item.question,
			"acceptedAnswer": { "@type": "Answer", "text": item.answer }
		}))
	})} />

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Dentist",
		"name": "Clínica Dental Sada Borrás",
		"description": "Clínica dental con instalaciones modernas en Pamplona y Tafalla. Gabinetes equipados con tecnología digital, escáner intraoral, CBCT y sedación consciente.",
		"url": "https://sadaborras.com/instalaciones",
		"department": [
			{
				"@type": "Dentist",
				"name": "Clínica Dental Sada Borrás — Pamplona",
				"address": { "@type": "PostalAddress", "streetAddress": "Avenida Pío XII, 8, bajo", "addressLocality": "Pamplona", "postalCode": "31008", "addressRegion": "Navarra", "addressCountry": "ES" },
				"telephone": "+34948172617"
			},
			{
				"@type": "Dentist",
				"name": "Clínica Dental Sada Borrás — Tafalla",
				"address": { "@type": "PostalAddress", "streetAddress": "Diputación Foral, 2, 2º C y D", "addressLocality": "Tafalla", "postalCode": "31300", "addressRegion": "Navarra", "addressCountry": "ES" },
				"telephone": "+34948702057"
			}
		]
	})} />
</MainLayout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const faqButtons = document.querySelectorAll('.faq-question');
		faqButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const faqItem = button.parentElement;
				const isExpanded = button.getAttribute('aria-expanded') === 'true';
				faqButtons.forEach((btn) => {
					if (btn !== button && btn.parentElement) {
						btn.setAttribute('aria-expanded', 'false');
						btn.parentElement.classList.remove('active');
					}
				});
				if (faqItem) {
					button.setAttribute('aria-expanded', String(!isExpanded));
					faqItem.classList.toggle('active');
				}
			});
		});
	});
</script>

<style>
	.installations-page { background: white; }

	/* Breadcrumbs */
	.breadcrumbs { padding: 1rem 0; background: #f8f9fb; border-bottom: 1px solid var(--c-gray-200); }
	.breadcrumbs ol { list-style: none; display: flex; gap: 0.5rem; margin: 0; padding: 0; font-size: var(--fs-small); }
	.breadcrumbs li { display: flex; align-items: center; gap: 0.5rem; margin: 0; font-size: var(--fs-small); color: var(--c-gray-500); }
	.breadcrumbs li + li::before { content: "/"; color: var(--c-gray-200); }
	.breadcrumbs a { color: var(--c-gray-500); font-size: var(--fs-small); }
	.breadcrumbs a:hover { color: var(--c-primary); }
	.breadcrumbs li[aria-current="page"] { color: var(--c-ink); font-weight: 500; }

	/* Hero */
	.page-hero {
		background: linear-gradient(135deg, rgba(10, 34, 64, 0.82) 0%, rgba(20, 58, 100, 0.78) 100%),
			var(--hero-bg, var(--c-primary)) center / cover no-repeat;
		padding: 5rem 0 4rem; text-align: center;
	}
	.page-hero h1 { color: white; font-size: var(--fs-h1); font-family: var(--ff-head); margin: 0 0 1rem 0; font-weight: 700; }
	.hero-subtitle { color: rgba(255, 255, 255, 0.95); font-size: var(--fs-h3); font-family: var(--ff-head); margin: 0; font-weight: 600; max-width: 700px; margin-left: auto; margin-right: auto; }

	/* Sections */
	.section-alt { background: #f8f9fb; }
	.section h2 { font-size: var(--fs-h2); font-family: var(--ff-head); color: var(--c-ink); margin-bottom: var(--spacing-sm); font-weight: 700; text-align: left; }
	.section h3 { font-size: var(--fs-h3); font-family: var(--ff-head); color: var(--c-ink); margin-bottom: 0.75rem; font-weight: 600; }
