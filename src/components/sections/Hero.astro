---
import { asset } from '../../utils/assets';

const posterUrl = asset('/img/poster.png');
---

<section class="hero" id="inicio">
	<div class="hero-bg">
		<video
			muted
			playsinline
			poster={posterUrl}
			id="hero-video-a"
			class="hero-video active"
		></video>
		<video
			muted
			playsinline
			id="hero-video-b"
			class="hero-video"
		></video>
	</div>
	<div class="hero-overlay"></div>
	<div class="container hero-content">
		<div class="hero-center">
			<div class="hero-logo">
				<img 
					src={asset("/icons/cropped-logo-dental-2-300x300.png")}
					alt="Logo Clínica Dental Sada Borrás"
					class="logo-white"
					width="90"
					height="90"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
			<h1>CLÍNICA DENTAL SADA BORRÁS</h1>
			<p class="hero-subtitle">"Tu clínica dental <span class="hero-highlight">de confianza</span> en Pamplona y Tafalla"</p>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 85vh;
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	
	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}
	
	.hero-bg video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		max-width: 100%;
		display: block;
	}
	
	.hero-video {
		position: absolute;
		top: 0;
		left: 0;
		opacity: 0;
		transition: opacity 0.6s ease;
	}

	.hero-video.active {
		opacity: 1;
	}
	
	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.4);
		z-index: 1;
	}
	
	.hero-content {
		position: relative;
		z-index: 2;
		padding: var(--spacing-xl) 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 600px;
		width: 100%;
	}
	
	.hero-center {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
	}
	
	.hero-logo {
		margin-bottom: 1.5rem;
	}
	
	.logo-white {
		width: 90px;
		height: 90px;
		max-width: 90px;
		display: block;
		filter: brightness(0) invert(1);
	}
	
	.hero h1 {
		font-size: var(--fs-h1);
		color: white;
		margin: 0 0 0.75rem 0;
		line-height: 1.2;
		font-family: var(--ff-head);
		font-weight: 700;
		letter-spacing: 0.5px;
	}
	
	.hero-subtitle {
		font-size: var(--fs-h3);
		color: white;
		margin: 0;
		font-style: italic;
		font-weight: 200;
		letter-spacing: 1px;
		font-family: var(--ff-body);
	}
	
	.hero-highlight {
		font-weight: 700;
	}
	
	
	@media (max-width: 767px) {
		.hero {
			min-height: 70vh;
			padding: 0 1rem;
		}
		
		.hero-content {
			min-height: 60vh;
			padding: var(--spacing-lg) 0;
		}
		
		.logo-white {
			max-width: 90px;
		}
		
		.hero h1 {
			letter-spacing: 0.5px;
			margin-bottom: 0.75rem;
		}
		
		.hero-subtitle {
			font-size: var(--fs-body);
		}
	}
</style>

<script>
	const BASE = 'https://pub-146edcb977de463eb79397c4bb7d8d06.r2.dev/';
	const PRIORITY = [11, 13];
	const FADE_MS = 600;

	function shuffle(arr: number[]): number[] {
		for (let i = arr.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[arr[i], arr[j]] = [arr[j], arr[i]];
		}
		return arr;
	}

	function buildPlaylist(): string[] {
		const prio = shuffle([...PRIORITY]);
		const rest = shuffle(
			Array.from({ length: 13 }, (_, i) => i + 1).filter(n => !PRIORITY.includes(n))
		);
		return [...prio, ...rest].map(n => `${BASE}video${n}.mp4`);
	}

	const elA = document.getElementById('hero-video-a') as HTMLVideoElement;
	const elB = document.getElementById('hero-video-b') as HTMLVideoElement;

	if (elA && elB) {
		let playlist = buildPlaylist();
		let idx = 0;
		let current = elA;
		let standby = elB;

		function nextUrl(): string {
			if (idx >= playlist.length) {
				playlist = buildPlaylist();
				idx = 0;
			}
			return playlist[idx++];
		}

		function preloadNext() {
			standby.src = nextUrl();
			standby.load();
		}

		function swap() {
			const doSwap = () => {
				standby.classList.add('active');
				current.classList.remove('active');
				standby.play().catch(() => {});

				const old = current;
				current = standby;
				standby = old;

				setTimeout(() => preloadNext(), FADE_MS + 100);
			};

			if (standby.readyState >= 3) {
				doSwap();
			} else {
				standby.addEventListener('canplay', doSwap, { once: true });
			}
		}

		elA.addEventListener('ended', () => { if (current === elA) swap(); });
		elB.addEventListener('ended', () => { if (current === elB) swap(); });

		function start() {
			current.src = nextUrl();
			current.load();
			current.addEventListener('canplay', () => {
				current.play().catch(() => {});
				preloadNext();
			}, { once: true });
		}

		const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
		idle(() => start());
	}
</script>
