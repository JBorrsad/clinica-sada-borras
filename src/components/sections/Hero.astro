---
import { asset } from '../../utils/assets';

const posterUrl = asset('/img/poster.png');
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="hero" id="inicio">
	<div class="hero-bg" style={`background-image: url(${posterUrl})`}>
		<video
			muted
			playsinline
			preload="none"
			id="hero-video-a"
			class="hero-video active"
		></video>
		<video
			muted
			playsinline
			id="hero-video-b"
			class="hero-video"
		></video>
	</div>
	<div class="hero-overlay"></div>
	<div class="hero-bottom-bar">
		<div class="container">
			<div class="hero-layout">
				<div class="hero-left">
					<h1><span class="hero-light">CLÍNICA DENTAL</span><br/>SADA BORRÁS</h1>
					<p class="hero-subtitle">"Tu clínica dental <span class="hero-highlight">de confianza</span> en Pamplona y Tafalla"</p>
					<div class="hero-buttons">
						<a href={`${baseUrl}sobre-nosotros`} class="btn btn-primary">Conoce más</a>
						<a href="#contacto" class="btn btn-secondary">Pide una cita</a>
					</div>
				</div>
				<div class="hero-right">
					<p class="hero-description">Llevamos más de cuatro décadas acompañando a familias de Navarra en cada etapa de su salud dental. Nos mueve la cercanía, la formación continua y el compromiso de tratarte como nos gustaría que nos tratasen a nosotros.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	
	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}
	
	.hero-bg video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		max-width: 100%;
		display: block;
	}
	
	.hero-video {
		position: absolute;
		top: 0;
		left: 0;
		opacity: 0;
		transition: opacity 0.6s ease;
	}

	.hero-video.active {
		opacity: 1;
	}
	
	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.4);
		z-index: 1;
	}
	
	.hero-bottom-bar {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		z-index: 2;
	}

	.hero-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: start;
		padding: 3.5rem 0;
		margin-bottom: 4rem;
	}

	.hero-left {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.hero h1 {
		font-size: var(--fs-h1);
		color: white;
		margin: 0;
		line-height: 1.15;
		font-family: var(--ff-head);
		font-weight: 700;
	}

	.hero-light {
		font-weight: 300;
	}

	.hero-subtitle {
		font-size: var(--fs-h3);
		color: rgba(255, 255, 255, 0.85);
		margin: 0;
		font-style: italic;
		font-weight: 200;
		font-family: var(--ff-body);
	}

	.hero-highlight {
		font-weight: 600;
	}

	.hero-buttons {
		display: flex;
		gap: 1rem;
		margin-top: 0.5rem;
	}

	.hero-buttons .btn-primary,
	.hero-buttons .btn-secondary {
		color: #fff;
		border: 2px solid rgba(255, 255, 255, 0.6);
		background: rgba(0, 0, 0, 0.3);
		backdrop-filter: blur(4px);
		white-space: nowrap;
	}

	.hero-buttons .btn-primary:hover,
	.hero-buttons .btn-secondary:hover {
		background: rgba(255, 255, 255, 0.15);
		border-color: #fff;
	}

	.hero-right {
		display: flex;
		align-items: flex-start;
		margin-top: calc(var(--fs-h1) * 1.15 + 5rem);
	}

	.hero-description {
		color: rgba(255, 255, 255, 0.8);
		margin: 0;
		max-width: 50ch;
	}

	@media (max-width: 767px) {
		.hero {
			min-height: 100svh;
		}

		.hero-bottom-bar {
			margin-bottom: 0;
		}
		
		.hero-layout {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 2rem 0;
			margin-bottom: 1.5rem;
		}

		.hero-right {
			margin-top: 0;
		}
		
		.hero-subtitle {
			font-size: var(--fs-body);
		}

		.hero-buttons {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>

<script>
	const BASE = 'https://pub-146edcb977de463eb79397c4bb7d8d06.r2.dev/';
	const PRIORITY = [11, 13];
	const FADE_MS = 600;

	function shuffle(arr: number[]): number[] {
		for (let i = arr.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[arr[i], arr[j]] = [arr[j], arr[i]];
		}
		return arr;
	}

	function buildPlaylist(): string[] {
		const prio = shuffle([...PRIORITY]);
		const rest = shuffle(
			Array.from({ length: 13 }, (_, i) => i + 1).filter(n => !PRIORITY.includes(n))
		);
		return [...prio, ...rest].map(n => `${BASE}video${n}.mp4`);
	}

	const elA = document.getElementById('hero-video-a') as HTMLVideoElement;
	const elB = document.getElementById('hero-video-b') as HTMLVideoElement;

	if (elA && elB) {
		let playlist = buildPlaylist();
		let idx = 0;
		let current = elA;
		let standby = elB;

		function nextUrl(): string {
			if (idx >= playlist.length) {
				playlist = buildPlaylist();
				idx = 0;
			}
			return playlist[idx++];
		}

		function preloadNext() {
			standby.src = nextUrl();
			standby.load();
		}

		function swap() {
			const doSwap = () => {
				standby.classList.add('active');
				current.classList.remove('active');
				standby.play().catch(() => {});

				const old = current;
				current = standby;
				standby = old;

				setTimeout(() => preloadNext(), FADE_MS + 100);
			};

			if (standby.readyState >= 3) {
				doSwap();
			} else {
				standby.addEventListener('canplay', doSwap, { once: true });
			}
		}

		elA.addEventListener('ended', () => { if (current === elA) swap(); });
		elB.addEventListener('ended', () => { if (current === elB) swap(); });

		function start() {
			current.src = nextUrl();
			current.preload = 'auto';
			current.load();
			current.addEventListener('canplay', () => {
				current.play().catch(() => {});
				preloadNext();
			}, { once: true });
		}

		start();
	}
</script>
