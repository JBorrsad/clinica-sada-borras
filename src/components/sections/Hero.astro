---
import { asset } from '../../utils/assets';

const posterUrl = asset('/img/poster.png');
const videoSrc1080 = 'https://pub-146edcb977de463eb79397c4bb7d8d06.r2.dev/hero-video-1080p.mp4';
const videoSrc1440 = 'https://pub-146edcb977de463eb79397c4bb7d8d06.r2.dev/hero-video-1440p.mp4';
---

<section class="hero" id="inicio">
	<div class="hero-bg">
		<video
			autoplay
			muted
			loop
			playsinline
			preload="none"
			poster={posterUrl}
			id="hero-video"
			data-src-1440={videoSrc1440}
		>
			<source src={videoSrc1080} type="video/mp4" />
		</video>
	</div>
	<div class="hero-overlay"></div>
	<div class="container hero-content">
		<div class="hero-center">
			<div class="hero-logo">
				<img 
					src={asset("/icons/cropped-logo-dental-2-300x300.png")}
					alt="Logo Clínica Dental Sada Borrás"
					class="logo-white"
					width="90"
					height="90"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
			<h1>CLÍNICA DENTAL SADA BORRÁS</h1>
			<p class="hero-subtitle">"Tu clínica dental <span class="hero-highlight">de confianza</span> en Pamplona y Tafalla"</p>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 85vh;
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	
	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}
	
	.hero-bg video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		max-width: 100%;
		display: block;
	}
	
	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.4);
		z-index: 1;
	}
	
	.hero-content {
		position: relative;
		z-index: 2;
		padding: var(--spacing-xl) 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 600px;
		width: 100%;
	}
	
	.hero-center {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
	}
	
	.hero-logo {
		margin-bottom: 1.5rem;
	}
	
	.logo-white {
		width: 90px;
		height: 90px;
		max-width: 90px;
		display: block;
		filter: brightness(0) invert(1);
	}
	
	.hero h1 {
		font-size: var(--fs-h1);
		color: white;
		margin: 0 0 0.75rem 0;
		line-height: 1.2;
		font-family: var(--ff-head);
		font-weight: 700;
		letter-spacing: 0.5px;
	}
	
	.hero-subtitle {
		font-size: var(--fs-h3);
		color: white;
		margin: 0;
		font-style: italic;
		font-weight: 200;
		letter-spacing: 1px;
		font-family: var(--ff-body);
	}
	
	.hero-highlight {
		font-weight: 700;
	}
	
	
	@media (max-width: 767px) {
		.hero {
			min-height: 70vh;
			padding: 0 1rem;
		}
		
		.hero-content {
			min-height: 60vh;
			padding: var(--spacing-lg) 0;
		}
		
		.logo-white {
			max-width: 90px;
		}
		
		.hero h1 {
			letter-spacing: 0.5px;
			margin-bottom: 0.75rem;
		}
		
		.hero-subtitle {
			font-size: var(--fs-body);
		}
	}
</style>

<script>
	const video = document.getElementById('hero-video') as HTMLVideoElement;
	if (video) {
		const conn = (navigator as any).connection;
		if (conn && conn.effectiveType === '4g' && !conn.saveData) {
			const hqSrc = video.dataset.src1440;
			if (hqSrc) {
				const source = video.querySelector('source');
				if (source) {
					source.src = hqSrc;
					video.load();
				}
			}
		}
	}
</script>
