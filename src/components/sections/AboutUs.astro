---
import { asset } from '../../utils/assets';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="about-section section--white" id="sobre-nosotros">
	<div class="container">
		<div class="about-container">
			<div class="about-text-column">
				<div class="about-text-content">
					<p class="about-description">Llevamos más de cuatro décadas acompañando a familias de Navarra en cada etapa de su salud dental. Nos mueve la cercanía, la formación continua y el compromiso de tratarte como nos gustaría que nos tratasen a nosotros.</p>
				</div>
			</div>
			<div class="about-buttons-column">
				<a href={`${baseUrl}sobre-nosotros`} class="btn-primary">Conoce más sobre nosotros</a>
				<a href="#contacto" class="btn-secondary">Pide una cita</a>
			</div>
		</div>
	</div>
</section>

<style>
	.about-section {
		position: relative;
		z-index: 10;
		padding: var(--spacing-xl) 0;
		background-color: #ffffff;
	}
	
	.about-container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		background: white;
	}
	
	.about-text-column {
		background: white;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3rem 2.5rem;
	}
	
	.about-text-content {
		max-width: 600px;
		width: 100%;
	}
	
	.about-description {
		font-size: 16px;
		font-weight: 300;
		line-height: 1.6;
		color: var(--c-ink);
		margin: 0;
		font-family: var(--ff-body);
		max-width: 65ch;
	}
	
	.about-buttons-column {
		background: white;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding: 3rem 2.5rem;
	}
	
	.about-buttons-column .btn-primary,
	.about-buttons-column .btn-secondary {
		white-space: nowrap;
	}
	
	@media (max-width: 768px) {
		.about-container {
			grid-template-columns: 1fr;
		}
		
		.about-text-column {
			padding: 3rem 2rem;
		}

		.about-buttons-column {
			flex-direction: column;
			gap: 1rem;
			padding: 2rem;
		}

		.about-buttons-column .btn-primary,
		.about-buttons-column .btn-secondary {
			width: auto;
			max-width: 280px;
		}
	}
</style>
